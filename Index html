<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Commerce Storefront</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              navy: '#0E1E45',
              gold: '#DDA728',
              goldHover: '#c5931f',
              bg: '#FDFBF7',
              accent: '#25D366'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-brand-bg text-gray-800 font-sans pb-20">

  <header class="bg-brand-navy text-white sticky top-0 z-40 shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      <button onclick="toggleDrawer()" class="text-2xl p-1 focus:outline-none">
        <i class="fa-solid fa-bars"></i>
      </button>

      <a href="#" class="text-xl font-bold tracking-wider text-brand-gold uppercase">
        STORE LOGO
      </a>

      <div class="flex items-center gap-4">
        <a href="#" class="relative">
          <i class="fa-regular fa-heart text-xl"></i>
        </a>
        <a href="#" class="relative">
          <i class="fa-solid fa-bag-shopping text-xl"></i>
          <span class="absolute -top-2 -right-2 bg-brand-gold text-brand-navy text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">2</span>
        </a>
      </div>
    </div>

    <div class="px-4 pb-3 max-w-7xl mx-auto">
      <div class="relative">
        <input type="text" placeholder="Search products..." class="w-full py-2 pl-4 pr-10 text-gray-900 rounded-full text-sm focus:outline-none shadow-inner">
        <button class="absolute right-3 top-2.5 text-gray-500">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </div>
  </header>

  <section class="p-4 max-w-7xl mx-auto">
    <div class="bg-brand-navy rounded-2xl p-6 text-white text-center shadow-lg relative overflow-hidden">
      <span class="bg-brand-gold text-brand-navy text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Wholesale & Retail</span>
      <h1 class="text-2xl font-extrabold mt-3">Quality Products At Affordable Prices</h1>
      <p class="text-gray-300 text-sm mt-2">Fast shipping nationwide & bulk order discounts</p>
      <div class="mt-4 flex justify-center gap-3">
        <a href="#products" class="bg-brand-gold text-brand-navy font-bold px-5 py-2.5 rounded-lg text-sm hover:bg-brand-goldHover transition">Shop Now</a>
        <a href="#categories" class="border border-white text-white font-bold px-5 py-2.5 rounded-lg text-sm hover:bg-white hover:text-brand-navy transition">Categories</a>
      </div>
    </div>
  </section>

  <section id="categories" class="p-4 max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-brand-navy">Shop by Category</h2>
      <a href="#" class="text-sm text-brand-gold font-semibold">View All &rarr;</a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-white p-4 rounded-xl shadow-sm text-center border border-gray-100 flex flex-col items-center">
        <div class="w-12 h-12 rounded-full bg-amber-50 text-brand-gold flex items-center justify-center text-xl mb-2">
          <i class="fa-solid fa-gem"></i>
        </div>
        <h3 class="font-bold text-sm text-gray-800">Jewelry</h3>
        <span class="text-xs text-gray-400">120+ Items</span>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm text-center border border-gray-100 flex flex-col items-center">
        <div class="w-12 h-12 rounded-full bg-amber-50 text-brand-gold flex items-center justify-center text-xl mb-2">
          <i class="fa-solid fa-shirt"></i>
        </div>
        <h3 class="font-bold text-sm text-gray-800">Apparel</h3>
        <span class="text-xs text-gray-400">85+ Items</span>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm text-center border border-gray-100 flex flex-col items-center">
        <div class="w-12 h-12 rounded-full bg-amber-50 text-brand-gold flex items-center justify-center text-xl mb-2">
          <i class="fa-solid fa-pump-soap"></i>
        </div>
        <h3 class="font-bold text-sm text-gray-800">Cosmetics</h3>
        <span class="text-xs text-gray-400">200+ Items</span>
      </div>

      <div class="bg-white p-4 rounded-xl shadow-sm text-center border border-gray-100 flex flex-col items-center">
        <div class="w-12 h-12 rounded-full bg-amber-50 text-brand-gold flex items-center justify-center text-xl mb-2">
          <i class="fa-solid fa-box-open"></i>
        </div>
        <h3 class="font-bold text-sm text-gray-800">Accessories</h3>
        <span class="text-xs text-gray-400">50+ Items</span>
      </div>
    </div>
  </section>

  <section id="products" class="p-4 max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-brand-navy">Featured Products</h2>
      <span class="text-xs text-gray-500">Updated Daily</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      
      <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 flex flex-col relative group">
        <span class="absolute top-2 left-2 bg-brand-navy text-white text-[10px] font-bold px-2 py-0.5 rounded">BESTSELLER</span>
        <span class="absolute top-2 right-2 bg-brand-gold text-brand-navy text-[10px] font-bold px-2 py-0.5 rounded">-23%</span>
        
        <div class="h-40 bg-gray-100 flex items-center justify-center p-4">
          <i class="fa-solid fa-box text-4xl text-gray-300"></i>
        </div>

        <div class="p-3 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] text-brand-gold uppercase font-bold tracking-wider">JEWELRY</span>
            <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 mt-1">Gold Plated Statement Ring</h3>
            <div class="flex items-center gap-2 mt-2">
              <span class="text-sm font-extrabold text-brand-navy">₦2,500</span>
              <span class="text-xs text-gray-400 line-through">₦3,250</span>
            </div>
          </div>
          <button class="w-full mt-3 py-1.5 border border-brand-navy text-brand-navy font-bold rounded text-xs hover:bg-brand-navy hover:text-white transition">
            View Details
          </button>
        </div>
      </div>

      <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 flex flex-col relative group">
        <span class="absolute top-2 left-2 bg-green-600 text-white text-[10px] font-bold px-2 py-0.5 rounded">NEW</span>
        
        <div class="h-40 bg-gray-100 flex items-center justify-center p-4">
          <i class="fa-solid fa-gift text-4xl text-gray-300"></i>
        </div>

        <div class="p-3 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] text-brand-gold uppercase font-bold tracking-wider">ACCESSORIES</span>
            <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 mt-1">Luxury Gift Packaging Box</h3>
            <div class="flex items-center gap-2 mt-2">
              <span class="text-sm font-extrabold text-brand-navy">₦1,200</span>
            </div>
          </div>
          <button class="w-full mt-3 py-1.5 border border-brand-navy text-brand-navy font-bold rounded text-xs hover:bg-brand-navy hover:text-white transition">
            View Details
          </button>
        </div>
      </div>

    </div>
  </section>

  <footer class="bg-brand-navy text-white mt-10">
    <div class="max-w-7xl mx-auto p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div>
        <h3 class="text-brand-gold font-bold text-base mb-2">STORE LOCATION & HOURS</h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          Main Branch: Commercial Avenue, Lagos, Nigeria<br>
          Monday – Saturday: 8:00 AM – 6:00 PM
        </p>
      </div>

      <div>
        <h3 class="text-brand-gold font-bold text-base mb-2">WHOLESALE & SUPPORT</h3>
        <p class="text-xs text-gray-300 mb-2">For bulk purchases and waybill inquiries:</p>
        <a href="tel:+2340000000000" class="text-sm font-bold text-white bg-white/10 px-3 py-2 rounded inline-block">
          <i class="fa-solid fa-phone text-brand-gold mr-2"></i>+234 000 000 0000
        </a>
      </div>

      <div>
        <h3 class="text-brand-gold font-bold text-base mb-2">TERMS & POLICIES</h3>
        <ul class="text-xs text-gray-300 space-y-1">
          <li>• Secure Checkout via Direct Transfer</li>
          <li>• No Refund / No Exchange Policy</li>
          <li>• Stockpile & Nationwide Delivery</li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 p-4 text-center text-xs text-gray-400">
      &copy; 2026 E-Commerce Store. All Rights Reserved.
    </div>
  </footer>

  <a href="https://wa.me/" target="_blank" class="fixed bottom-5 right-5 bg-brand-accent text-white w-12 h-12 rounded-full flex items-center justify-center text-2xl shadow-lg z-50 hover:scale-110 transition">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <div id="drawer" class="fixed inset-0 bg-black/50 z-50 hidden transition-opacity">
    <div class="w-4/5 max-w-sm bg-white h-full shadow-2xl p-5 flex flex-col justify-between">
      <div>
        <div class="flex justify-between items-center mb-6">
          <span class="text-lg font-bold text-brand-navy">Menu</span>
          <button onclick="toggleDrawer()" class="text-gray-500 text-xl">&times;</button>
        </div>
        <nav class="space-y-4 text-sm font-medium text-gray-700">
          <a href="#" class="block py-2 border-b border-gray-100 hover:text-brand-gold">Home</a>
          <a href="#categories" class="block py-2 border-b border-gray-100 hover:text-brand-gold">All Categories</a>
          <a href="#products" class="block py-2 border-b border-gray-100 hover:text-brand-gold">Featured Items</a>
          <a href="#" class="block py-2 border-b border-gray-100 hover:text-brand-gold">Wholesale Info</a>
          <a href="#" class="block py-2 hover:text-brand-gold">Contact Us</a>
        </nav>
      </div>
      <div class="text-xs text-gray-400 text-center">
        Storefront v1.0
      </div>
    </div>
  </div>

  <script>
    function toggleDrawer() {
      const drawer = document.getElementById('drawer');
      drawer.classList.toggle('hidden');
    }
  </script>
</body>
</html>
